{
  "name": "framerate",
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.7.2",
    "typescript": "^5.0.0",
    "unlighthouse": "1.0.0-beta.1",
    "wrangler": "^4.144.0"
  },
  "packageManager": "^bun@1.2.9",
  "private": true,
  "scripts": {
    "biome": "biome check --write --unsafe",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "biome:format:check": "biome format .",
    "biome:lint": "biome lint --write .",
    "biome:lint:check": "biome lint .",
    "build": "turbo run build",
    "check-types": "turbo run check-types --skipLibCheck",
    "db:migrate:local": "bun run --cwd packages/database db:migrate:local",
    "db:migrate:remote": "bun run --cwd packages/database db:migrate:remote",
    "db:backfill-prices:local": "bun run --cwd packages/database db:backfill-prices:local",
    "dev": "turbo run dev",
    "dev:ingest": "turbo run dev --filter=ingest",
    "dev:match": "turbo run dev --filter=match",
    "dev:normalize": "turbo run dev --filter=normalize",
    "dev:server": "turbo run dev --filter=server",
    "dev:web": "turbo run dev --filter=web",
    "studio": "bun run --cwd apps/studio dev",
    "lint": "turbo run biome:lint",
    "perf:telefonos": "bun scripts/perf-telefonos.ts",
    "prepare": "simple-git-hooks || true",
    "test": "turbo run test"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run biome:check",
    "pre-push": "bun run biome:check && bun run build"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
