# Force LF line endings for all text files, regardless of OS.
# Prevents Windows tooling (biome, prettier, generators) from leaving
# spurious CRLF-only diffs in the working tree.
* text=auto eol=lf

# Windows-native scripts must keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Generated / binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
