{
  "name": "@framerate/database",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "db:migrate:local": "wrangler d1 migrations apply framerate --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply framerate --remote",
    "db:backfill-prices:local": "wrangler d1 execute framerate --local --persist-to ../../.wrangler/state --file=scripts/backfill-price-daily.sql"
  },
  "dependencies": {
    "kysely": "^0.29.7",
    "kysely-d1": "^0.4.0",
    "miniflare": "^4.20260730.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@framerate/config": "workspace:*",
    "@types/bun": "1.3.9",
    "typescript": "5.9.3",
    "wrangler": "^4.152.0"
  }
}
