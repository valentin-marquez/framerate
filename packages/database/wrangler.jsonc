{
  // Sólo se usa para aplicar migraciones (`bun run db:migrate:*`). Los Workers
  // (apps/server y apps/ingest) declaran su propio binding a la MISMA base.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "framerate-database",
  // El studio (apps/studio) lee de aquí la cuenta y la base.
  "account_id": "3f50a4a123ebcbcb917dababff3ef8b5",
  "compatibility_date": "2026-01-05",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framerate",
      // bunx wrangler d1 create framerate  → pegar el mismo id en los 3 wrangler.jsonc
      "database_id": "6537cc10-7e7b-4dba-9c01-ce80e6a840eb",
      "migrations_dir": "migrations"
    }
  ]
}
