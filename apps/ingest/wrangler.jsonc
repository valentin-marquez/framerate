{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "framerate-ingest",
  "account_id": "3f50a4a123ebcbcb917dababff3ef8b5",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "observability": { "enabled": true },

  // Este Worker NO recibe tráfico público: sólo Cron, Queue y RPC desde apps/server.

  // Cada 6 h (UTC): fotos, reclamos, cuarentena, `views_7d`. Cada hora: la agenda de cada StoreCrawler, que es
  // quien crawlea su tienda (#121); el horario debe coincidir con HOURLY_CRON de src/index.ts.
  "triggers": { "crons": ["17 */6 * * *", "47 * * * *"] },

  // Un DO por tienda: serializa sus corridas y reparte su crawl de 6 h con un desfase propio.
  // Crear, borrar o renombrar la clase sólo con `wrangler deploy` (no `versions upload`); rollback en #201 §7.
  "durable_objects": { "bindings": [{ "name": "STORE_CRAWLER", "class_name": "StoreCrawler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreCrawler"] }],

  "vars": {
    // `views_7d` sale de la API SQL de Analytics Engine; el token va aparte: wrangler secret put ANALYTICS_API_TOKEN.
    "CF_ACCOUNT_ID": "3f50a4a123ebcbcb917dababff3ef8b5",
    // Relay de salida (#154) para tiendas con `egress: "relay"`; el token va aparte: wrangler secret put RELAY_TOKEN.
    "RELAY_URL": "https://relay.nozz.skin",
    // Achica las fotos de producto (#170); el token va aparte: wrangler secret put RESIZER_TOKEN.
    "RESIZER_URL": "https://resizer.nozz.skin"
  },

  // Los crawls consumen CPU parseando JSON; subir el límite por invocación.
  "limits": { "cpu_ms": 120000 },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framerate",
      // Debe ser el MISMO id que en packages/database y apps/server.
      "database_id": "6537cc10-7e7b-4dba-9c01-ce80e6a840eb"
    }
  ],

  "r2_buckets": [
    // bunx wrangler r2 bucket create framerate-snapshots
    // Retención: bunx wrangler r2 bucket lifecycle add framerate-snapshots snapshots-14d snapshots/ --expire-days 14
    { "binding": "SNAPSHOTS", "bucket_name": "framerate-snapshots" },
    // Público en https://cdn.framerate.cl (dominio propio del bucket): fotos de producto copiadas por el Cron.
    // bunx wrangler r2 bucket create framerate-assets
    { "binding": "ASSETS", "bucket_name": "framerate-assets" }
  ],

  // Correos de la plataforma (Cloudflare Email Service): avisos de reclamo vencido o con TXT perdido.
  "send_email": [{ "name": "EMAIL" }],

  "queues": {
    "producers": [
      // Las consumen framerate-normalize y framerate-match (#153); toda oferta nueva o cambiada pasa por ellas.
      { "binding": "NORMALIZE_QUEUE", "queue": "framerate-normalize" },
      { "binding": "LINK_QUEUE", "queue": "framerate-link" }
    ]
  }
}
