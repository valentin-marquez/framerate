{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "framerate",
  "workers_dev": false,
  "preview_urls": true,
  "compatibility_date": "2026-01-05",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  // importante para que no sobreescriba las variables de entorno que se definen en el dashboard de cloudflare
  // Lee el readme para saber mas sobre esto
  // recuerda definir las variables de entorno en el dashboard de cloudflar o_o
  "keep_vars": true
}
