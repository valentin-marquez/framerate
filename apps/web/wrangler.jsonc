{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "framerate",
  "compatibility_date": "2026-01-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
