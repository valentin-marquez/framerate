{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "framerate-server",
  "account_id": "3f50a4a123ebcbcb917dababff3ef8b5",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "observability": { "enabled": true },
  // D1 vive en ENAM: correr cerca de la base paga un viaje largo por request y no uno por consulta.
  // Sólo afecta al fetch (incluido el service binding de la web), no al RPC.
  "placement": { "mode": "smart" },

  // Este Worker sólo atiende HTTP. Ni Cron ni colas ni R2 de scraping: eso es de apps/ingest.

  // Dominio propio: Cloudflare crea el DNS y el certificado.
  "routes": [{ "pattern": "api.framerate.cl", "custom_domain": true }],

  // Públicas y fijas por despliegue. En local mandan las de .dev.vars.
  "vars": {
    "BETTER_AUTH_URL": "https://api.framerate.cl",
    "WEB_ORIGIN": "https://framerate.cl",
    "COOKIE_DOMAIN": "framerate.cl",
    // Dominio propio del bucket framerate-assets (lo llena apps/ingest), con transformaciones de Images en la zona.
    "ASSETS_BASE_URL": "https://cdn.framerate.cl"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framerate",
      // Debe ser el MISMO id que en packages/database y apps/ingest.
      "database_id": "6537cc10-7e7b-4dba-9c01-ce80e6a840eb"
    }
  ],

  // RPC hacia apps/ingest ("crawlear ahora"). Requiere desplegar ingest primero.
  "services": [{ "binding": "INGEST", "service": "framerate-ingest", "entrypoint": "IngestRpc" }],

  "ratelimits": [
    { "name": "PUBLIC_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 600, "period": 60 } }
  ],

  // Correos de la plataforma (Cloudflare Email Service). En `wrangler dev` el envío se simula: no sale nada.
  "send_email": [{ "name": "EMAIL" }]

  // Secretos (no van aquí): BETTER_AUTH_SECRET, ADMIN_TOKEN, ADMIN_TOKENS (opcional), DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET
  //   → bunx wrangler secret put <NOMBRE>. Detalle en docs/identity.md
}
