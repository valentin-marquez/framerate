SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Service role: necesario para crear tickets de soporte anónimos.
# Mantener en secret store de Cloudflare (wrangler secret put SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile secret key (server-side). Si no se setea en dev,
# el endpoint salta la verificación (sólo aceptable local).
TURNSTILE_SECRET_KEY=

# Webhook de Discord para notificar nuevos tickets de soporte.
# Tratar como secret: cualquiera con la URL puede postear.
DISCORD_SUPPORT_WEBHOOK_URL=
# User ID de Discord a etiquetar en cada notificación de ticket.
DISCORD_SUPPORT_PING_USER_ID=
