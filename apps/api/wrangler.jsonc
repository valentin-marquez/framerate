{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "framerate-api",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": true,
  "keep_vars": true,
  "compatibility_date": "2026-01-05",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "ratelimits": [
    {
      "name": "STRICT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "MODERATE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "LENIENT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 200, "period": 60 }
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 50, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}