{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "framerate-match",
  "account_id": "3f50a4a123ebcbcb917dababff3ef8b5",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "observability": { "enabled": true },

  // 30 minutos después del cron de ingest (17 */6): recoge las revisiones que dejaron esos crawls.
  "triggers": { "crons": ["47 */6 * * *"] },

  "vars": {
    // shadow: guarda en evidence lo que haría, sin resolver. reject: sólo rechaza (deja un duplicado). live: acepta y
    // rechaza, y espera los requisitos de #117.
    "MATCH_MODE": "live",
    // De los 10.000 neurons gratis al día de Workers AI. Se dejan 2.000 fuera para los scripts de experimentos y
    // para lo que venga (#110, #125): es el único Worker que usa AI hoy. Un par nuevo cuesta 3,3 neurons medidos,
    // así que 8.000 alcanzan para unos 2.400 pares al día.
    "MATCH_DAILY_NEURONS": "8000",
    // off: nada. shadow: cuenta los productos duplicados que ya existen sin escribir. on: les abre revisión (#148).
    "MATCH_DETECT": "on",
    // Segunda opinión de Claude Haiku 5.5 sobre lo que Gemma deja pendiente (#149). off, shadow o live; la
    // clave va con `wrangler secret put ANTHROPIC_API_KEY`.
    "MATCH_HAIKU": "live",
    // Del crédito de $100 al mes de la API de Anthropic (plan Max), lo que puede gastar este Worker; el resto queda
    // para el asistente (#110). Un par cuesta ~$0,0006, así que alcanza de sobra. El tope de cada día es lo que queda
    // del ciclo repartido entre los días que faltan, y el ciclo se renueva el día del pago del plan.
    "ANTHROPIC_MONTHLY_USD": "30",
    "ANTHROPIC_CYCLE_DAY": "17",
    // Vínculo desde la identidad de Haiku (#153). off: ignora la cola. shadow: sólo escribe `match_shadow` (qué haría
    // contra el vínculo actual). live: vincula, crea productos con el nombre canónico y los publica.
    "PIPELINE_LINK": "live",
    // El preprocesador dice qué producto del catálogo es el mismo SKU (#157). shadow: sólo queda en
    // `listing_identity.same_as`. live: vincula cuando la identidad no calza por clave y nada lo contradice.
    "LINK_SAME_AS": "shadow"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framerate",
      "database_id": "6537cc10-7e7b-4dba-9c01-ce80e6a840eb"
    }
  ],

  "ai": { "binding": "AI" },

  "queues": {
    "producers": [{ "binding": "VERIFY_QUEUE", "queue": "framerate-match-verify" }],
    "consumers": [
      {
        "queue": "framerate-match-verify",
        "max_batch_size": 10,
        // Cada par son dos pedidos a Workers AI: con 3 en paralelo, seis a la vez. Si hay 429, bajar a 1.
        "max_concurrency": 3,
        "max_retries": 3,
        "dead_letter_queue": "framerate-match-verify-dlq"
      },
      {
        "queue": "framerate-link",
        "max_batch_size": 10,
        // En serie: dos ofertas del mismo producto nuevo en paralelo crearían dos productos (spec §1).
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "framerate-link-dlq"
      }
    ]
  }
}
